# Скопировать в .env и заполнить реальными значениями. Файл .env в git не коммитится (§15).
#
# ВНИМАНИЕ ПРО РАЗВЁРТЫВАНИЕ: адрес размещения (`/clinic`) переменной окружения
# НЕ задаётся. Он зашит в сборку через `basePath` в next.config.ts и берётся из
# src/base-path.ts (D-51): Next подставляет его в имена статических файлов на
# этапе сборки, поэтому менять его на запущенном контейнере нечем — нужна
# пересборка образа.
#
# Значения ниже — для локальной разработки. Для сервера (docker-compose.prod.yml)
# пути к данным и COOKIE_SECURE переопределяются в самом compose-файле.

# --- База данных ---------------------------------------------------------
# Путь к файлу SQLite. Каталог создаётся автоматически при миграции.
# В контейнере: /app/data/clinic.db (том clinic-data).
DATABASE_FILE=./data/clinic.db

# --- Резервное копирование (§15, NFR-16) ---------------------------------
# Каталог резервных копий для `npm run db:backup`.
# Копия делается механизмом SQLite `VACUUM INTO`, а не копированием файла:
# при работе в режиме WAL обычный cp даёт неполную или битую копию.
# Каталог по умолчанию лежит внутри ./data и не коммитится; для реальной
# клиники его следует вынести на отдельный носитель.
BACKUP_DIR=./data/backups

# --- Учётные записи (§2.3: ровно два общих аккаунта) ---------------------
# Используются только скриптом сидинга (npm run db:seed).
# Пароли в БД хранятся исключительно в виде argon2id-хеша (§3.1, §15).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_STAFF_USERNAME=staff
SEED_STAFF_PASSWORD=change-me-staff-password

# --- Сессии --------------------------------------------------------------
# Время бездействия до истечения сессии, часов (Q-37, допущение: 12).
SESSION_TTL_HOURS=12
# true в проде: cookie отдаётся только по HTTPS (§15, NFR-11/NFR-13).
# В локальной разработке по http:// поставить false, иначе браузер не сохранит cookie.
# На сервере значение задаёт docker-compose.prod.yml (COOKIE_SECURE=true) —
# приложение стоит за Caddy, который терминирует HTTPS.
# Атрибут Path у cookie не настраивается: он равен basePath (D-51), иначе
# токен сессии уходил бы соседним приложениям того же домена.
COOKIE_SECURE=false

# --- Ограничение попыток входа (§3.1, Q-36) ------------------------------
# Блокировка по паре (username, IP), а не по username целиком:
# при двух общих аккаунтах блокировка `staff` остановила бы всю операционную.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Patient ID ----------------------------------------------------------
# Отдельный случайный 32-byte ключ в base64. Не менять после появления записей:
# без прежнего ключа сохранённые Patient ID нельзя будет расшифровать или найти.
# Пример генерации: openssl rand -base64 32
PATIENT_ID_SECRET=
