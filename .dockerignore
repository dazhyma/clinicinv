# Контекст сборки образа. Всё, что сюда попадает, видит `docker build`,
# поэтому исключаем секреты и данные клиники в первую очередь (§15).

# Секреты: в образ не попадают никогда, переменные приходят из окружения.
.env
.env.*
!.env.example

# Данные клиники: база, фотографии, резервные копии.
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Артефакты, которые пересобираются внутри образа.
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# Ничего из этого в рантайме не нужно.
.git/
.gitignore
.claude/
tests/
vitest.config.ts
docs/
*.md
Dockerfile
.dockerignore
docker-compose*.yml

# Мусор.
.DS_Store
*.log
npm-debug.log*
